APP_NAME="Argos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://id.airinter-va.org
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
ARGOS_NAME="Argos"
ARGOS_RELEASE=

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=airinter_id
DB_USERNAME=
DB_PASSWORD=
# Argos tables are never prefixed. Do not set DB_PREFIX for this application.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
AUTH_PASSWORD_TIMEOUT=900
PASSKEYS_USER_HANDLE_SECRET=

CACHE_STORE=database
QUEUE_CONNECTION=database

# Temporary read-only bridge used only by the migration/import command.
# Prefer a dedicated MySQL user limited to SELECT on the Promethee database.
PROMETHEE_DB_HOST=127.0.0.1
PROMETHEE_DB_PORT=3306
PROMETHEE_DB_DATABASE=
PROMETHEE_DB_USERNAME=
PROMETHEE_DB_PASSWORD=
PROMETHEE_DB_PREFIX=phpvms7_
PROMETHEE_PILOT_ID_PREFIX=IT
PROMETHEE_PILOT_ID_LENGTH=3

AIRINTER_ID_PROMETHEE_URL=https://promethee.airinter-va.org
AIRINTER_ID_PUBLIC_URL=https://www.airinter-va.org
AIRINTER_ID_HERMES_NAME="Hermès"
AIRINTER_ID_PROMETHEE_CALLBACK=https://promethee.airinter-va.org/auth/airinter-id/callback
AIRINTER_ID_HERMES_CALLBACK=http://127.0.0.1:47821/callback
AIRINTER_ID_PUBLIC_CALLBACK=https://www.airinter-va.org/auth/airinter-id/callback

ARGOS_TRUSTED_DEVICE_DAYS=30
ARGOS_SECURITY_ADMIN_SUBJECTS=
