$fieldc1 = stripslashes('<p style=\"text-align: center\"><span style=\"color:#333399;\"><span style=\"font-size: large\"><span style=\"text-decoration: underline\"><strong>MANUEL D\'OPERATIONS AIR INTER VIRTUAL AIRLINE</strong></span></span></span><br />
