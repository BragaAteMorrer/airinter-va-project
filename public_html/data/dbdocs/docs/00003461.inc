	<li style=\"text-align: justify;\"><span style=\"color:#000000;\"><span style=\"font-size: medium\">Fokker F28-4000 (</span></span><span style=\"color:#000000;\"><span style=\"font-size: medium\">loué auprès de&nbsp;</span></span><span style=\"color:#000000;\"><span style=\"font-size: medium\">Touraine Air Transport TAT)</span></span></li>
