	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Lockheed L-1049G Super Constellation&nbsp;</span><span style=\"color:#000000;\">(</span><span style=\"color:#000000;\">leased from </span><span style=\"color:#000000;\">Air France)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Vickers Viscount 708</span></span></span></li>
	<li style=\"text-align: justify;\">&nbsp;<span style=\"font-size:16px;\">Nord N260A</span><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Super Bushranger&nbsp;</span><span style=\"color:#000000;\">(mainly used for N260A/N262B evaluation)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Nord N262B Frégate</span></span></span></li>
