$fieldc2 = stripslashes('<h2 style=\"text-align: center;\"><span style=\"font-size:22px;\"><span style=\"color:#000000;\"><span style=\"text-decoration: underline\"><strong>AIRCRAFT OPERATING MANUAL</strong></span></span></span><br />
&nbsp;</h2>

<h2 style=\"text-align: justify;\"><span style=\"color:#000000;\"></span><br />
<span style=\"color:#000000;\"><span style=\"font-size: large\"><strong>1-OPERATIONS BASES<br />
2-AIR INTER FLEET<br />
3-THE SUBSIDIARY<br />
4-THE DIVISION<br />
5-LINE OPERATIONS<br />
6-SUBSTITUTE AIRCRAFT</strong></span></span><br />
<span style=\"color:#000000;\">&nbsp;<br />
<br />
<span style=\"font-size: medium\"><span style=\"text-decoration: underline\"><strong>1-OPERATIONS BASES</strong></span></span></span></h2>

<p style=\"text-align: justify;\"><span style=\"color:#000000;\"><span style=\"font-size: medium\"><strong>1.0 </strong>- <span style=\"font-size:16px;\"><span style=\"font-family:Arial;\">Air Inter Virtual Airlines est basée, comme dans la réalité, sur le hub de Paris-Orly Ouest (LFPO).</span></span><br />
&nbsp;<br />
<strong>1.1</strong> - <span style=\"font-size:16px;\"><span style=\"font-family:Arial;\">Reserved</span></span></span></span><br />
&nbsp;</p>

<h2 style=\"text-align: justify;\"><span style=\"color:#000000;\"><span style=\"text-decoration: underline\"><strong><span style=\"font-size: medium\">2-AIR INTER FLEET</span></strong></span></span><br />
&nbsp;</h2>

<p style=\"text-align: justify;\"><span style=\"color:#000000;\"><span style=\"font-size: medium\"><strong>2.0</strong> -&nbsp;</span></span><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\">The Air Inter Virtual Airlines fleet consists of aircraft that were actually used by Air Inter throughout its 37 years of commercial operation.</span></span><br />
<span style=\"color:#000000;\"><span style=\"font-size: medium\">&nbsp;<br />
<strong>2.1</strong> -&nbsp;</span></span><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\">The Air Inter Virtual Airlines fleet is divided into three periods:<br />
<span style=\"color:#000000;\">&nbsp;<br />
<strong>a) 1st period - 1982-1997:</strong></span></span></span></p>

<ul>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\">&nbsp;Sud Aviation Caravelle Super 12</span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Dassault Mercure 100</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Airbus A300-B4-2C</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Boeing 747-123 LX-LCV (</span><span style=\"color:#000000;\">leased from </span><span style=\"color:#000000;\">Cargolux&nbsp;</span><span style=\"color:#000000;\">between</span><span style=\"color:#000000;\">&nbsp;01/04/1987 and 29/10/1987)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Boeing 747-123 LX-MCV (</span><span style=\"color:#000000;\">leased from </span><span style=\"color:#000000;\">Cargolux&nbsp;</span><span style=\"color:#000000;\">between</span><span style=\"color:#000000;\">&nbsp;01/07/1986 and 02/07/1986)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Boeing 747-128A F-BPVD (</span><span style=\"color:#000000;\">leased from </span><span style=\"color:#000000;\">Air France&nbsp;</span><span style=\"color:#000000;\">between</span><span style=\"color:#000000;\">&nbsp;01/04/1988 and 30/04/1989)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Boeing 747-2B4B N204AE (</span><span style=\"color:#000000;\">leased from </span><span style=\"color:#000000;\">Nigeria Airways&nbsp;</span><span style=\"color:#000000;\">between</span><span style=\"color:#000000;\">&nbsp;11/11/1986 and 30/06/1987)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Fokker F28-0100 (better known as&nbsp;Fokker 100)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Airbus A319-113 (under Air Inter Europe livery)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Airbus A320-111 (first A320 version without&nbsp;winglet)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Airbus A320-211 (most common version with&nbsp;winglets)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Airbus A321-111</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Airbus A330-301</span></span></span></li>
</ul>

<p style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\"><br />
<strong>b) 2nd period - 1970-1981:</strong></span></span></span></p>

<ul>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\">&nbsp;Fokker F27-500</span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Vickers Viscount 708</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Vickers Viscount 724</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Sud Aviation Caravelle III</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Dassault Mercure 100</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Airbus A300-B2-1C</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Airbus A300-B4-2C</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Douglas DC-8-63PF (leased from UTA between 01/04/1974 and 31/10/1975)</span><span style=\"color:#000000;\"></span></span></span></li>
</ul>

<p style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;<br />
<strong>c) 3rd period - 1958-1969:</strong></span></span></span></p>

<ul>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\">&nbsp;Douglas DC-3&nbsp;<span style=\"color:#000000;\">(non-pressurized, leased from Air France)</span></span></span></li>
	<li style=\"text-align: justify;\"><span style=\"font-size:16px;\"><span style=\"font-family:Arial;\"><span style=\"color:#000000;\">&nbsp;Vickers Viking VC-1&nbsp;</span><span style=\"color:#000000;\">(</span><span style=\"color:#000000;\">non-pressurized, leased from </span><span style=\"color:#000000;\">Airnautic)</span></span></span></li>
