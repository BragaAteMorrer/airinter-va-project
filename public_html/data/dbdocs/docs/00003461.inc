	<li style=\"text-align: justify;\"><span style=\"color:#000000;\"><span style=\"font-size: medium\">Airbus A320-212</span></span><span style=\"color:#000000;\"><span style=\"font-size: medium\"></span></span><br />
	<br />
	<span style=\"color:#000000;\"><span style=\"font-size: medium\">Appareils Loués :</span></span><br />
	&nbsp;</li>
