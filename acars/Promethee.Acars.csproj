<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
  <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
  <!-- The Linux Docker build restores the Windows desktop target too. -->
  <EnableWindowsTargeting>true</EnableWindowsTargeting>
  <UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWPF>
  <OutputType Condition="'$(TargetFramework)' == 'net8.0-windows'">WinExe</OutputType>
  <OutputType Condition="'$(TargetFramework)' == 'net8.0'">Exe</OutputType>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <AssemblyName>Promethee.Acars</AssemblyName>
  <Product>Hermès — Air Inter Virtual Airlines</Product>
  <Title>Hermès ACARS</Title>
  <Description>Client ACARS officiel Air Inter Virtual Airlines</Description>
  <Company>Air Inter Virtual Airlines</Company>
  <Authors>Air Inter Virtual Airlines</Authors>
  <Copyright>Air Inter Virtual Airlines</Copyright>
  <ApplicationIcon Condition="'$(TargetFramework)' == 'net8.0-windows'">assets\hermes.ico</ApplicationIcon>
</PropertyGroup>
<ItemGroup>
  <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup>
<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
  <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" />
  <PackageReference Include="FSUIPCClientDLL" Version="3.3.16" />
  <Compile Remove="FsuipcNativeSession.Stub.cs" />
  <Resource Include="assets\hermes.ico" />
</ItemGroup>
<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
  <FrameworkReference Include="Microsoft.AspNetCore.App" />
  <Compile Remove="FsuipcNativeSession.Windows.cs" />
</ItemGroup>
<ItemGroup>
  <!-- Build artifacts must never become web assets in the next single-file build. -->
  <Content Remove="release\**" />
  <None Remove="release\**" />
  <Compile Remove="Program.cs" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
  <Compile Remove="DesktopProgram.cs" />
  <Compile Remove="WebDesktop.cs" Condition="'$(TargetFramework)' == 'net8.0'" />
</ItemGroup>
</Project>
